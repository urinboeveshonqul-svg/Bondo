# ---------------------------------------------------------------------------
# Bondo — environment variables
#
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored; this file is committed and must never contain a real secret.
#
# Every variable here is parsed and validated by `lib/env.ts` at boot — a
# missing or malformed value fails fast with a readable message.
# ---------------------------------------------------------------------------

# --- Public (inlined into the client bundle — never put a secret here) ------

# Supabase project REST URL.
# Hosted:  Dashboard → Project Settings → Data API → Project URL
# Local:   http://127.0.0.1:54321  (printed by `npm run db:start`)
#
# This is the https:// REST URL, NOT the postgresql:// connection string shown
# nearby in the dashboard. Pasting the connection string is the single most
# common mistake here; the build rejects it by scheme.
# Values must not carry a trailing newline — that is also rejected, because it
# survives every length check and would silently break auth at runtime.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon / publishable key. Safe to expose: it is constrained by Row
# Level Security. It is NOT an authorisation mechanism on its own — RLS is.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Canonical origin of this deployment. Used for metadataBase, absolute Open
# Graph URLs, sitemap entries and auth redirect callbacks.
#
# Optional. Resolution order (see lib/env.ts):
#   1. this variable, if set
#   2. https://$NEXT_PUBLIC_VERCEL_URL — set automatically on Vercel, which is
#      what gives preview deployments their own correct URLs instead of
#      production's
#   3. http://localhost:3000 in development
#
# Set it explicitly on the production deployment so the custom domain is used
# rather than the *.vercel.app hostname. Leave it unset on previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never prefixed with NEXT_PUBLIC_) ------------------------

# Supabase service role key. BYPASSES ROW LEVEL SECURITY — treat it like a
# database superuser password. Required only for admin tooling, webhooks and
# background jobs (`supabase/admin.ts`); leave blank until something needs it.
SUPABASE_SERVICE_ROLE_KEY=
